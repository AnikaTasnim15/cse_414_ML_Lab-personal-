# define the captioning model
def define_model(vocab_size, max_length):

    # feature extractor model
    inputs1 = Input(shape=(4096,))
#     fe1 = Dropout(0.2)(inputs1)  
    fe2 = Dense(128, activation='relu')(inputs1) 
    fe3 = Dense(256, activation='relu')(fe2)  
    # sequence model
    inputs2 = Input(shape=(max_length,))
#     se1 = Dropout(0.2)(inputs2) 
    se2 = Embedding(vocab_size, 128, mask_zero=True)(inputs2)
    se3 = Bidirectional(LSTM(256,return_sequences=True))(se2)  
    se4 = Bidirectional(LSTM(128))(se3)
    # decoder model
    decoder1 = add([fe3, se4])
    decoder2 = Dense(128, activation='relu')(decoder1)
    decoder3 = Dense(256, activation='relu')(decoder2)
    decoder4 = Dropout(0.5)(decoder3) 
    outputs = Dense(vocab_size, activation='softmax')(decoder4)
    # tie it together [image, seq] [word]
    model = Model(inputs=[inputs1, inputs2], outputs=outputs)
    # compile model
    model.compile(loss='categorical_crossentropy', optimizer ='rmsprop',  metrics =['accuracy'])  
    # summarize model
    model.summary()
    return model


